# ========================
# Monorepo root .gitignore
# ========================

# Re-include common source file extensions (overrides parent-level ignores)
!*.json
!*.yaml
!*.yml
!*.ts
!*.tsx
!*.js
!*.jsx
!*.css
!*.svg

# ========================
# Dependencies
# ========================
node_modules/
.pnpm-store/

# ========================
# Build output
# ========================
out/
dist/
build/
dist-electron/
# Root-anchored: ignore only a top-level build "release/" dir, never the
# spec/changes/<key>/specs/release/ spec-document directories.
/release/
*.tgz

# ========================
# Lock files (pnpm only)
# ========================
package-lock.json
yarn.lock

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
.cursor/
*.swp
*.swo
.windsurfrules
.claude/
.agent/
.sisyphus/
文档/

# ========================
# OS
# ========================
.DS_Store
Thumbs.db

# ========================
# Logs
# ========================
*.log
npm-debug.log*
pnpm-debug.log*

# ========================
# Environment
# ========================
.env
.env.local
.env.*.local
.dev.vars
apps/web-cloudflare/.dev.vars
apps/web-cloudflare/.wrangler/
apps/web-cloudflare/scripts/*.local.txt

# Signing credentials
*.p8
*.p12
*.pfx
AuthKey_*.p8
DeveloperID*.p12
DeveloperID*.pfx

# ========================
# Test / Coverage
# ========================
coverage/
.nyc_output/
test-results/
playwright-report/
.playwright-cli/
output/playwright/
.playwright-mcp/

# ========================
# Cache
# ========================
.cache/
.codegraph/
.parcel-cache/
.eslintcache

# ========================
# Bundle analysis output
# ========================
apps/desktop/dist-stats/

# ========================
# Database (local dev databases)
# ========================
*.db
*.sqlite
*.sqlite3
apps/web/data/
apps/web/data-first-run-*/
packages/db/src/index.js
packages/db/src/index.js.map
packages/shared/types/index.js
packages/shared/types/index.js.map

# ========================
# Temporary files
# ========================
*.tmp
*.temp
*.tsbuildinfo
.omx/
.workbuddy/
.zcode/

# ========================
# Promotional / marketing materials (local only)
# 宣传文档、介绍视频、宣传图等对外推广物料统一放在 promo/，
# 不进入 Git、不上传 GitHub（仓库只保留可构建的功能性资源）。
# 后续生成的宣传类文档/视频/图片请直接放入 promo/。
# ========================
/promo/

# ========================
# Generated deliverables / agent working output (local only)
# outputs/ 是 AI 助手生成的产物目录：宣传文章、配图、视频工程、
# BGM、截图等，均为本地交付物，不进入 Git、不上传 GitHub。
# ========================
/outputs/

# ========================
# Website article drafts (local only)
# website/articles/ 存放面向公众号/博客的宣传文章草稿、构建脚本与
# 配图（article.md / article.html / build_article.py / imgs），
# 属于对外宣传物料，不进入 Git。
# ========================
/website/articles/
